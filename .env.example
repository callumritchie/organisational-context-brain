# Schema migrations and fixture reset use the owning role.
DATABASE_URL_OWNER=postgresql://postgres:postgres@localhost:5432/org_brain

# Connectors use a dedicated non-owning role with workspace-scoped write policies.
DATABASE_URL_INGEST=postgresql://org_brain_ingest:org_brain_ingest@localhost:5432/org_brain
DATABASE_PASSWORD_INGEST=org_brain_ingest

# The application role is deliberately non-owning and subject to RLS.
DATABASE_URL_APP=postgresql://org_brain_app:org_brain_app@localhost:5432/org_brain
DATABASE_PASSWORD_APP=org_brain_app
DATABASE_POOL_MAX=8

APP_BASE_URL=http://localhost:3000

# Required for production API reads. Tokens are verified against this fixed
# issuer, audience and HTTPS JWKS endpoint; workspace and role come from the
# server-owned external identity mapping, never from token claims.
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_AUTHORIZATION_URL=
AUTH_OIDC_TOKEN_URL=
AUTH_OIDC_CLIENT_ID=
# Optional for a public-client registration; otherwise keep this in a managed secret store.
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=https://brain.example.com/api/v1/auth/callback
AUTH_PUBLIC_ORIGIN=https://brain.example.com
# One-time administrative inputs for `npm run auth:link-identity -- --confirm`.
AUTH_LINK_SUBJECT=
AUTH_LINK_USER_ID=
AUTH_LINK_WORKSPACE_ID=
AUTH_LINK_CAPABILITIES=
# One-time administrative inputs for `npm run auth:disable-identity -- --confirm`.
AUTH_DISABLE_SUBJECT=
AUTH_DISABLE_WORKSPACE_ID=
# Read-only administrative inputs for `npm run auth:export-audit`.
AUTH_AUDIT_WORKSPACE_ID=
AUTH_AUDIT_SINCE=

# Long-running production operations defaults.
WORKER_INTERVAL_MS=2000
SCHEDULER_INTERVAL_MS=60000
APP_COMMIT_SHA=
DEPLOYMENT_ENFORCE_CONFIG=false

# Staging certification. Keep the bearer token in an ignored local file or the
# protected GitHub `staging` environment, never in source control.
STAGING_BASE_URL=
STAGING_EXPECTED_COMMIT=
STAGING_EXPECTED_IDP_ORIGIN=
STAGING_TEST_BEARER_TOKEN=
STAGING_PUBLIC_ONLY=false
STAGING_LOAD_TARGET=ready
STAGING_LOAD_REQUESTS=50
STAGING_LOAD_CONCURRENCY=2
STAGING_LOAD_MAXIMUM_P95_MS=2000
STAGING_LOAD_MINIMUM_SUCCESS_RATE=0.99
STAGING_LOAD_CONFIRM=

# Read-only isolated restore verification. These must never point at the source.
RECOVERY_DRILL_CONFIRM=
DATABASE_URL_RECOVERY_OWNER=
DATABASE_URL_RECOVERY_APP=
# Use provider only when all chat settings below are deliberately configured.
AI_MODE=offline
CHAT_PROVIDER=
OPENAI_CHAT_MODEL=

# Optional. Keep unset for lexical-only retrieval. Never commit a real key.
EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
